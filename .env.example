# Resend Email Configuration
# 1. Get an API key from https://resend.com
# 2. Add and verify your domain (fresh360degrees.in) at https://resend.com/domains
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=support@fresh360degrees.in
RESEND_FROM_EMAIL=Fresh 360 <notifications@fresh360degrees.in>

# Admin Dashboard Authentication (Server-side only)
# Used for protected /admin dashboard and Sanity Studio access
ADMIN_USER=fresh360admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_32_byte_session_secret

# WhatsApp Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=9705522020

# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token with read/write access to store enquiries
SANITY_API_TOKEN=your_sanity_editor_write_token_here

NEXT_PUBLIC_SITE_URL=https://fresh360degrees.in

# Temporary Single-Page Mode Toggle (Set to false or remove to restore full multi-page site)
NEXT_PUBLIC_SINGLE_PAGE_MODE=true
